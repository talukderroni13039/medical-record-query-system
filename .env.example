# Copy to .env.dev (or .env.uat) and adjust. Every value except the API key has a default in code.
APP_ENV=dev
LOG_LEVEL=DEBUG

# --- Embeddings (local) ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "
# Set to 1 after the first successful model download (no network at runtime)
HF_HUB_OFFLINE=0

# --- Vector store / data ---
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=patient_records
RECORDS_DIR=./data/records

# --- Chunking / retrieval ---
CHUNK_SIZE=256
CHUNK_OVERLAP=32
DEFAULT_TOP_K=5
MAX_TOP_K=20

# --- Optional answer generation ---
# none = retrieval only, fully on-prem (default)
# anthropic = sends retrieved chunks to the Anthropic API (NOT on-prem; synthetic data only)
ANSWER_PROVIDER=none
ANTHROPIC_API_KEY=your-anthropic-api-key-here
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=1000
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=30
